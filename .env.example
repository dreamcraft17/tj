# Trusted Jurist — salin ke .env.local dan isi nilai asli
# cp .env.example .env.local

# ─── Email (Resend — direkomendasikan) ───
# https://resend.com → API Keys → verifikasi domain trustedjurist.co.id
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=Trusted Jurist <noreply@trustedjurist.co.id>
ADMIN_EMAIL=konsultasi@trustedjurist.co.id
ADMIN_PASSWORD=change-this-admin-password
ADMIN_SESSION_SECRET=change-this-32-byte-session-secret

# ─── reCAPTCHA v3 (opsional di dev, wajib di production) ───
# https://www.google.com/recaptcha/admin/create
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ─── Rate limiting opsional (Upstash Redis, multi-instance) ───
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ─── Recruitment storage (phase 1: configure S3-compatible provider) ───
# DO_SPACES_ENDPOINT=
# DO_SPACES_BUCKET=
# DO_SPACES_ACCESS_KEY_ID=
# DO_SPACES_SECRET_ACCESS_KEY=
